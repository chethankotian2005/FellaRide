# Server
PORT=4000
NODE_ENV=development

# Firebase Admin SDK (from your Firebase project's service account JSON)
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n escapes in the private key when pasting it into .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Firebase Realtime Database URL if used alongside Firestore
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
